# ==============================================================================
# Moxy Concierge — Environment Configuration Template
# ==============================================================================
# Duplicate this file as .env and fill in your actual API credentials:
# cp .env.example .env

# ------------------------------------------------------------------------------
# 1. Claude AI Intelligence (Anthropic)
# ------------------------------------------------------------------------------
# Primary engine for conversational hospitality & autonomous tool calling
# Get your API key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ------------------------------------------------------------------------------
# 2. Indian Railways & IRCTC Live Telemetry (RapidAPI)
# ------------------------------------------------------------------------------
# Powers:
# - irctc-indian-railway-pnr-status.p.rapidapi.com (Real-time PNR & Berth verification)
# - indian-railway-irctc.p.rapidapi.com (Live GPS Train Status & Delays)
# - irctc1.p.rapidapi.com (Live Station Boards & Platform info)
# Subscribe at: https://rapidapi.com/
RAPIDAPI_KEY=your-rapidapi-key-here
VITE_RAPIDAPI_KEY=your-rapidapi-key-here

# ------------------------------------------------------------------------------
# 3. Aviationstack Flight Tracking API
# ------------------------------------------------------------------------------
# Live flight schedules, airport arrivals/departures, baggage belts, and telemetry
# Get your key at: https://aviationstack.com/
AVIATIONSTACK_API_KEY=your-aviationstack-api-key-here
VITE_AVIATIONSTACK_API_KEY=your-aviationstack-api-key-here

# ------------------------------------------------------------------------------
# 4. Google Maps Platform (Routes API & Geocoding)
# ------------------------------------------------------------------------------
# Precise turn-by-turn routing, transit times, and distance calculations
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
